# ─── Discord ────────────────────────────────────────────────
# Créer l'app sur : https://discord.com/developers/applications
# 1. New Application → Bot → Reset Token → DISCORD_TOKEN
# 2. OAuth2 → Client ID → CLIENT_ID
# 3. Clic droit sur ton serveur Discord → Copier l'ID → GUILD_ID
# 4. Clic droit sur ton profil → Copier l'ID → OWNER_ID
# 5. Bot → activer "Message Content Intent"
# 6. OAuth2 > URL Generator → scopes: bot + applications.commands
#    permissions: Send Messages, Embed Links, Read Message History, Use Slash Commands
#    → invite le bot avec l'URL générée

DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
OWNER_ID=

# ─── Ollama ──────────────────────────────────────────────────
# En local : http://localhost:11434
# En cluster k8s : http://ollama.ollama.svc.cluster.local:11434
OLLAMA_HOST=http://ollama.ollama.svc.cluster.local:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── PostgreSQL ──────────────────────────────────────────────
# En cluster k8s : warframe-postgres.bots.svc.cluster.local
# En local : localhost
POSTGRES_HOST=warframe-postgres.bots.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=warframe
POSTGRES_USER=warframe
POSTGRES_PASSWORD=
